{
  "name": "@umbra-escrow-and-dispute-window/umbra-sdk",
  "version": "0.1.0-rc.1",
  "description": "TypeScript client and off-chain hashing conventions for the Umbra escrow and dispute-window protocol on Stellar",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "deployments"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/umbra-escrow-and-dispute-window/umbra-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "prettier": "^3.9.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.6"
  }
}
