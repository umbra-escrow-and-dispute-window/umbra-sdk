# Copy to .env for local Testnet integration tests. Never commit a real secret.
# Testnet only. These are read by test/integration.test.ts, which is skipped
# entirely when STELLAR_SECRET is unset.

# Buyer secret key (S...). Funds the escrow.
STELLAR_SECRET=

# Seller account (G...) and its secret (S...) for marking delivery.
STELLAR_SELLER=
STELLAR_SELLER_SECRET=

# Arbiter secret (S...). Defaults to STELLAR_SECRET if unset.
STELLAR_ARBITER=

# Escrow asset contract id (C...). Native XLM wrapped as a SAC works.
STELLAR_ASSET=
