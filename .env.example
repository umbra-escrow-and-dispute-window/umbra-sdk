# Umbra SDK - Environment Configuration Template
# Copy this file to .env for running live Soroban Testnet integration tests.
# Never commit real secret keys!

# Buyer account secret key (funded on Stellar Testnet)
STELLAR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Seller public key and secret key (funded on Stellar Testnet)
STELLAR_SELLER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_SELLER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional separate arbiter secret key (defaults to STELLAR_SECRET if omitted)
STELLAR_ARBITER=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban token contract ID on Testnet (e.g., wrapped native XLM or test USDC)
STELLAR_ASSET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional custom Soroban RPC endpoint override
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
